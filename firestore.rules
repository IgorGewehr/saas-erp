rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the user document for the authenticated user
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Get the user's businessId
    function userBusinessId() {
      return getUserDoc().businessId;
    }

    // Check if the user belongs to the specified business
    function belongsToBusiness(businessId) {
      return isAuthenticated() && userBusinessId() == businessId;
    }

    // Check if the resource's businessId matches the user's business
    function isOwnBusiness() {
      return isAuthenticated() && resource.data.businessId == userBusinessId();
    }

    // Check if incoming data's businessId matches the user's business
    function incomingBelongsToBusiness() {
      return isAuthenticated() && request.resource.data.businessId == userBusinessId();
    }

    // Role hierarchy values
    function roleValue(role) {
      return role == 'founder' ? 100 :
             role == 'admin' ? 80 :
             role == 'manager' ? 60 :
             role == 'operator' ? 40 :
             role == 'viewer' ? 20 : 0;
    }

    // Get user's role numeric value
    function userRoleValue() {
      return roleValue(getUserDoc().role);
    }

    // Check if user has at least the specified role
    function hasMinRole(minRole) {
      return isAuthenticated() && userRoleValue() >= roleValue(minRole);
    }

    // Check if user is admin or founder
    function isAdmin() {
      return hasMinRole('admin');
    }

    // Check if user is manager or above
    function isManager() {
      return hasMinRole('manager');
    }

    // Check if user is operator or above
    function isOperator() {
      return hasMinRole('operator');
    }

    // Validate required string field
    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Users can read their own profile
      // Users can read profiles of people in the same business
      allow read: if isAuthenticated()
                  && (request.auth.uid == userId || belongsToBusiness(resource.data.businessId));

      // Users can only update their own profile
      // Admins can update users in their business (for role changes, etc.)
      allow update: if isAuthenticated()
                    && (request.auth.uid == userId
                        || (isAdmin() && belongsToBusiness(resource.data.businessId)));

      // User creation happens during signup (auth trigger or client-side)
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Only founders can delete users (soft delete preferred)
      allow delete: if isAuthenticated()
                    && hasMinRole('founder')
                    && belongsToBusiness(resource.data.businessId)
                    && request.auth.uid != userId; // Cannot delete yourself
    }

    // ============================================
    // BUSINESSES COLLECTION
    // ============================================
    match /businesses/{businessId} {
      // Members of the business can read
      allow read: if isAuthenticated() && belongsToBusiness(businessId);

      // Business is created during signup
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUserId == request.auth.uid;

      // Only admin/founder can update business settings.
      // Exception: any business member can add themselves to memberIds (invite-code signup).
      allow update: if isAuthenticated()
                    && belongsToBusiness(businessId)
                    && (isAdmin()
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
                            && request.resource.data.memberIds.toSet().hasAll(resource.data.memberIds.toSet())
                            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid])));

      // Only founder can delete
      allow delete: if isAuthenticated()
                    && belongsToBusiness(businessId)
                    && hasMinRole('founder');
    }

    // ============================================
    // INVITE CODES COLLECTION
    // ============================================
    match /inviteCodes/{code} {
      // Anyone authenticated can read (for code validation during signup)
      allow read: if isAuthenticated();

      // Only admin/founder can create invite codes
      allow create: if isAuthenticated()
                    && isAdmin()
                    && incomingBelongsToBusiness();

      // Allow update: only the code's own business admin can revoke,
      // or any authenticated user can mark as used (but cannot change businessId or role)
      allow update: if isAuthenticated()
                    && (
                      // Admin/founder of the code's business can do anything (revoke, etc.)
                      (isAdmin() && belongsToBusiness(resource.data.businessId))
                      ||
                      // During signup: anyone can mark as used, but cannot change businessId or role
                      (
                        request.resource.data.businessId == resource.data.businessId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.code == resource.data.code
                        && request.resource.data.isActive == false
                        && resource.data.isActive == true
                      )
                    );

      // Only admin/founder can delete
      allow delete: if isAuthenticated()
                    && isAdmin()
                    && isOwnBusiness();
    }

    // ============================================
    // CLIENTS COLLECTION (primary entity — replaces crmContacts)
    // ============================================
    match /clients/{clientId} {
      // Operators and above can read clients in their business
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      // Operators and above can create clients
      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator()
                    && isNonEmptyString(request.resource.data.name);

      // Operators and above can update clients
      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      // Only managers and above can delete
      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // ORDERS COLLECTION (B2B sales / vendas)
    // ============================================
    match /orders/{orderId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // PURCHASE NOTES COLLECTION (compras / NF-e de entrada)
    // ============================================
    match /purchaseNotes/{noteId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isManager();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isManager();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager()
                    && incomingBelongsToBusiness();

      // Purchase notes are immutable fiscal records — no deletion
      allow delete: if false;
    }

    // ============================================
    // APPOINTMENTS COLLECTION
    // ============================================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator()
                    && isNonEmptyString(request.resource.data.clientName)
                    && isNonEmptyString(request.resource.data.date)
                    && isNonEmptyString(request.resource.data.startTime);

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // SERVICES COLLECTION
    // ============================================
    match /services/{serviceId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isManager()
                    && isNonEmptyString(request.resource.data.name);

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // MENU CATEGORIES COLLECTION
    // ============================================
    match /menuCategories/{categoryId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isManager();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // PRODUCTS COLLECTION
    // ============================================
    match /products/{productId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isManager()
                    && isNonEmptyString(request.resource.data.name);

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // STOCK MOVEMENTS COLLECTION
    // ============================================
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator()
                    && request.resource.data.type in ['entrada', 'saida', 'ajuste'];

      // Stock movements are immutable (append-only ledger)
      allow update: if false;
      allow delete: if false;
    }

    // ============================================
    // SALES COLLECTION
    // ============================================
    match /sales/{saleId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator()
                    && request.resource.data.status in ['aberta', 'finalizada', 'cancelada'];

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      // Only managers can delete sales
      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // TRANSACTIONS (FINANCIAL) COLLECTION
    // ============================================
    match /transactions/{transactionId} {
      // Only managers and above can see financial data
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isManager();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isManager()
                    && request.resource.data.type in ['receita', 'despesa']
                    && request.resource.data.status in ['pendente', 'pago', 'atrasado', 'cancelado'];

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // BANK ACCOUNTS COLLECTION
    // ============================================
    match /bankAccounts/{accountId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isManager();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isAdmin();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // KANBAN BOARDS COLLECTION
    // ============================================
    match /kanbanBoards/{boardId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // KANBAN TEMPLATES COLLECTION
    // ============================================
    match /kanbanTemplates/{templateId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // KANBAN CARDS COLLECTION
    // ============================================
    match /kanbanCards/{cardId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator();
    }

    // ============================================
    // CRM CONTACTS COLLECTION
    // ============================================
    match /crmContacts/{contactId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator()
                    && isNonEmptyString(request.resource.data.name);

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // CRM DEALS COLLECTION
    // ============================================
    match /crmDeals/{dealId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // ============================================
    // CRM ACTIVITIES COLLECTION
    // ============================================
    match /crmActivities/{activityId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator();
    }

    // ============================================
    // FISCAL DOCUMENTS COLLECTION
    // ============================================
    match /fiscalDocuments/{docId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isManager();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isManager()
                    && request.resource.data.type in ['nfse', 'nfce', 'nfe'];

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager()
                    && incomingBelongsToBusiness();

      // Fiscal documents should not be deleted (legal requirement)
      allow delete: if false;
    }

    // ============================================
    // CONVERSATIONS COLLECTION
    // ============================================
    match /conversations/{conversationId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // CONVERSATION MESSAGES COLLECTION
    // ============================================
    match /conversationMessages/{messageId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      // Messages are append-only - no updates or deletes
      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator();
      allow delete: if false;
    }

    // ============================================
    // SAAS API KEYS COLLECTION
    // ============================================
    match /saasApiKeys/{keyId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isAdmin();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isAdmin();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // BROADCASTS COLLECTION
    // ============================================
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // BROADCAST MESSAGES COLLECTION
    // ============================================
    match /broadcastMessages/{messageId} {
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isOperator();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness()
                    && request.resource.data.broadcastId == resource.data.broadcastId;

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // CHANNEL CONNECTIONS COLLECTION
    // Cada doc é uma conexão de canal (WhatsApp Cloud, WhatsApp Baileys,
    // Facebook, Instagram). Pode pertencer ao business ('business' ownerType,
    // canal compartilhado) ou a um usuário específico ('user', canal pessoal
    // do operador, suportado apenas em Baileys).
    // ============================================
    match /channelConnections/{connectionId} {
      // Read:
      //   - admin/founder: tudo
      //   - operator+: connections 'business' OU connections 'user' do próprio uid
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && (
                    isAdmin()
                    || (resource.data.ownerType == 'business' && isOperator())
                    || (resource.data.ownerType == 'user'
                        && resource.data.ownerId == request.auth.uid)
                  );

      // Create:
      //   - admin/founder: connections de qualquer ownerType
      //   - operator+: apenas connections 'user' com ownerId == próprio uid
      // Garante que não dá pra criar canal pessoal alheio.
      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && (
                      isAdmin()
                      || (request.resource.data.ownerType == 'user'
                          && request.resource.data.ownerId == request.auth.uid
                          && isOperator())
                    );

      // Update:
      //   - admin/founder: pode tudo, INCLUSIVE mudar ownerType/ownerId
      //     (cenário: operador saiu, admin transfere canal-user pra ownerType=
      //     'business' ou pra outro operador. Sem essa permissão precisaria
      //     deletar+recriar e perder histórico).
      //   - operator+: só seu próprio canal 'user' E não pode mudar ownership
      //     (anti-escalation: operator não vira admin do próprio canal).
      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && incomingBelongsToBusiness()
                    && (
                      isAdmin()
                      || (
                        resource.data.ownerType == 'user'
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerType == resource.data.ownerType
                        && request.resource.data.ownerId == resource.data.ownerId
                      )
                    );

      // Delete:
      //   - admin/founder: qualquer
      //   - operator+: só própria 'user' connection
      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && (
                      isAdmin()
                      || (resource.data.ownerType == 'user'
                          && resource.data.ownerId == request.auth.uid)
                    );
    }

    // ============================================
    // WEBHOOK FAILURES COLLECTION (Dead-letter queue)
    // ============================================
    match /webhookFailures/{docId} {
      // Only admins can read failed webhook entries
      allow read: if isAuthenticated() && isAdmin();

      // Written by webhook handler (server-side, no auth context)
      // HMAC signature verification on the webhook endpoint provides the security layer
      allow create: if true;

      // Only admins can update or delete
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // ============================================
    // SECTORS COLLECTION
    // ============================================
    match /sectors/{sectorId} {
      allow read: if isAuthenticated() && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isAdmin();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // SNIPPETS COLLECTION (Quick replies)
    // ============================================
    match /snippets/{snippetId} {
      allow read: if isAuthenticated() && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // SEGMENTS COLLECTION (CRM audience segments)
    // ============================================
    match /segments/{segmentId} {
      allow read: if isAuthenticated() && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin();
    }

    // ============================================
    // DELIVERY ORDERS (novo módulo Pedidos — modo 'pedidos')
    // ============================================
    match /deliveryOrders/{orderId} {
      allow read: if isAuthenticated() && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && isManager();
    }

    // Contadores sequenciais (subcollection businesses/{id}/counters/{name})
    match /businesses/{businessId}/counters/{counterId} {
      allow read, write: if isAuthenticated() && belongsToBusiness(businessId);
    }

    // ============================================
    // AGENT NONCES (replay protection for HMAC requests)
    // ============================================
    // Written exclusively by the server (Admin SDK) when verifying inbound
    // agent requests. Clients must never read or write these.
    match /agentNonces/{nonceId} {
      allow read, write: if false;
    }

    // ============================================
    // AGENT RUNS (logs do agente IA)
    // ============================================
    match /agentRuns/{runId} {
      // Apenas admin+ pode ver logs do agente — informação sensível (pode conter dados do cliente)
      allow read: if isAuthenticated() && isOwnBusiness() && isAdmin();

      // Writes são feitos pelo Python agent via admin SDK (bypassa regras). Permitimos
      // writes autenticados no mesmo tenant para uso de desenvolvimento/debug.
      allow create, update: if isAuthenticated() && incomingBelongsToBusiness() && isAdmin();

      allow delete: if isAuthenticated() && isOwnBusiness() && hasMinRole('founder');
    }

    // ============================================
    // KNOWLEDGE CHUNKS (RAG index — Wave 3)
    // ============================================
    // Only accessed via admin SDK from API routes. Client-side reads not needed.
    // Reading the embedding array is heavy and not useful for the UI.
    match /knowledgeChunks/{chunkId} {
      allow read, write: if false;  // admin-only (via API)
    }

    // ============================================
    // AGENT MEMORY (tier-2 semantic facts per contact — Wave 3)
    // ============================================
    // Subcollection under businesses/{bId}/agentMemory/{contactId}. Managed
    // exclusively by agent tools via admin SDK. UI may want to read for a
    // future "what the agent remembers about this contact" panel.
    match /businesses/{businessId}/agentMemory/{contactId} {
      allow read: if isAuthenticated() && businessId == userBusinessId() && isOperator();
      allow write: if false;  // writes only through API routes
    }

    // ============================================
    // FINANCIAL AUDIT LOG (trilha imutável de mudanças)
    // ============================================
    match /financialAuditLog/{logId} {
      // Qualquer membro com acesso a financeiro vê o log
      allow read: if isAuthenticated() && isOwnBusiness() && isOperator();

      // Create: qualquer operator+ (o sistema loga sua própria ação)
      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator()
                    && request.resource.data.actorUid == request.auth.uid;

      // Imutável — ninguém edita ou apaga logs
      allow update, delete: if false;
    }

    // ============================================
    // PASSWORD VAULT (shared admin credential store)
    // ============================================
    // Writes/reads happen via server API routes using admin SDK (bypasses rules),
    // but defense in depth: enforce admin-only + tenant isolation + access scope.
    match /passwordVaultEntries/{entryId} {
      // Read: admin+ of the business AND either scope is 'admins' OR uid is in sharedWith
      allow read: if isAuthenticated()
                  && isOwnBusiness()
                  && isAdmin()
                  && (
                    resource.data.accessScope == 'admins' ||
                    resource.data.createdBy == request.auth.uid ||
                    (resource.data.sharedWith is list && resource.data.sharedWith.hasAny([request.auth.uid]))
                  );

      // Create: admin+ of the business, title required (password optional)
      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isAdmin()
                    && isNonEmptyString(request.resource.data.title);

      // Update: admin+ of the business, same tenant
      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isAdmin()
                    && incomingBelongsToBusiness();

      // Delete: creator or founder
      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && (resource.data.createdBy == request.auth.uid || hasMinRole('founder'));
    }

    // ============================================
    // NOTES COLLECTION (Mural de Notas)
    // ============================================
    match /notes/{noteId} {
      // O filtro entre notas pessoais e da equipe (scope/authorId) 
      // é feito no client-side para evitar a exigência de índices compostos.
      allow read: if isAuthenticated() && isOwnBusiness();

      // Any authenticated business member can create notes
      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && request.resource.data.authorId == request.auth.uid
                    && isNonEmptyString(request.resource.data.content);

      // Authors can update their own notes; any business member can update team notes
      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && (resource.data.authorId == request.auth.uid || resource.data.scope == 'team');

      // Authors can delete their own notes; managers can delete any note
      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && (resource.data.authorId == request.auth.uid || isManager());
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notifId} {
      // Users can read their own notifications
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;

      // Any authenticated business member can create notifications for others
      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isNonEmptyString(request.resource.data.title);

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;

      // Users can delete their own notifications
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // FORM TEMPLATES COLLECTION
    // ============================================
    match /formTemplates/{templateId} {
      allow read: if isAuthenticated() && isOwnBusiness();
      allow create: if isAuthenticated() && incomingBelongsToBusiness() && isAdmin();
      allow update: if isAuthenticated() && isOwnBusiness() && isAdmin();
      allow delete: if isAuthenticated() && isOwnBusiness() && isAdmin();
    }

    // ============================================
    // FORM RESPONSES COLLECTION
    // ============================================
    match /formResponses/{responseId} {
      // Business members can read responses
      allow read: if isAuthenticated() && isOwnBusiness();
      // Public submissions handled by Admin SDK (API route) — no client-side create needed
      allow create: if isAuthenticated() && incomingBelongsToBusiness();
      allow delete: if isAuthenticated() && isOwnBusiness() && isManager();
    }

    // ============================================
    // REVIEWS COLLECTION
    // ============================================
    match /reviews/{reviewId} {
      allow read: if isAuthenticated() && isOwnBusiness();
      // Public submissions handled by Admin SDK (API route)
      allow create: if false; // only via server
      allow delete: if isAuthenticated() && isOwnBusiness() && isAdmin();
    }

    // ============================================
    // AUTOMATION RULES COLLECTION
    // ============================================
    match /automationRules/{ruleId} {
      allow read: if isAuthenticated() && isOwnBusiness();
      allow create: if isAuthenticated() && incomingBelongsToBusiness() && isAdmin();
      allow update: if isAuthenticated() && isOwnBusiness() && isAdmin();
      allow delete: if isAuthenticated() && isOwnBusiness() && isAdmin();
    }

    // ============================================
    // BANK RECONCILIATION COLLECTIONS
    // ============================================
    match /bankStatementImports/{importId} {
      allow read: if isAuthenticated() && isOwnBusiness();
      allow create: if isAuthenticated() && incomingBelongsToBusiness() && isManager();
      allow delete: if isAuthenticated() && isOwnBusiness() && isAdmin();
    }

    match /reconciliationItems/{itemId} {
      allow read: if isAuthenticated() && isOwnBusiness();
      allow create: if isAuthenticated() && incomingBelongsToBusiness() && isManager();
      allow update: if isAuthenticated() && isOwnBusiness() && isManager();
      allow delete: if isAuthenticated() && isOwnBusiness() && isAdmin();
    }

    // ============================================
    // MEMBERSHIPS COLLECTION
    // ============================================
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && isOwnBusiness();
      allow create: if isAuthenticated() && incomingBelongsToBusiness() && isAdmin();
      allow update: if isAuthenticated() && isOwnBusiness() && isAdmin();
      allow delete: if isAuthenticated() && isOwnBusiness() && isAdmin();
    }

    match /clientMemberships/{cmId} {
      allow read: if isAuthenticated() && isOwnBusiness();
      allow create: if isAuthenticated() && incomingBelongsToBusiness() && isManager();
      allow update: if isAuthenticated() && isOwnBusiness() && isManager();
      allow delete: if isAuthenticated() && isOwnBusiness() && isAdmin();
    }

    // ============================================
    // CALENDAR SYNC TOKENS COLLECTION
    // ============================================
    match /calendarSyncTokens/{uid} {
      // Only the token owner can read (contains encrypted tokens)
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // Created/updated by server (OAuth callback) — no client-side write
      allow write: if false;
    }

    // ============================================
    // CONVERSATION VIEWS (saved filter presets)
    // ============================================
    match /conversationViews/{viewId} {
      allow read: if isAuthenticated() && isOwnBusiness();

      allow create: if isAuthenticated()
                    && incomingBelongsToBusiness()
                    && isOperator();

      allow update: if isAuthenticated()
                    && isOwnBusiness()
                    && isOperator()
                    && incomingBelongsToBusiness();

      allow delete: if isAuthenticated()
                    && isOwnBusiness()
                    && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ============================================
    // CSAT RESPONSES (customer satisfaction)
    // ============================================
    match /csatResponses/{responseId} {
      // Operators can read their business's responses
      allow read: if isAuthenticated() && isOwnBusiness();
      // Written by server-side (webhook/API) — client cannot write
      allow write: if false;
    }

    // ============================================
    // CATCH-ALL: Deny everything else
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
