# ─── APP SETTINGS ─────────────────────────────────────────────────────────────
# URL base do sistema (Ngrok em dev, dominio real em producao)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── FIREBASE CONFIG ──────────────────────────────────────────────────────────
# Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (JSON em uma unica linha)
# Gere em: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT=

# ─── META / FACEBOOK CONFIG ──────────────────────────────────────────────────
# Painel: https://developers.facebook.com/apps/
META_APP_ID=
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=

# Webhook Verify Tokens (definidos no painel Meta > Webhooks)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_FACEBOOK_VERIFY_TOKEN=

# ─── SEFAZ / FISCAL ──────────────────────────────────────────────────────────
SEFAZ_API_URL=http://localhost:3333
SEFAZ_API_KEY=

# ─── SECURITY / ENCRYPTION ───────────────────────────────────────────────────
# Chave AES-256-GCM para criptografar tokens de canais no Firestore (32 chars)
ENCRYPTION_KEY=

# Chave dedicada para criptografar a SENHA do certificado digital A1 (.pfx).
# Deve ser exatamente 64 caracteres HEX (= 32 bytes). Gere com:
#   openssl rand -hex 32
# Obrigatório para habilitar upload de certificado digital na aba Fiscal.
CERT_PASSWORD_ENCRYPTION_KEY=

# ─── GOOGLE CALENDAR ─────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AGENTE IA (LangGraph) ───────────────────────────────────────────────────
# Segredo compartilhado com o serviço Python do agente (ver agent/.env)
AGENT_SHARED_SECRET=
# URL do serviço Python do agente
AGENT_SERVICE_URL=http://localhost:8080
# Segredo do Vercel Cron — usado por:
#  - /api/agent/scheduled/run (agente IA)
#  - /api/broadcasts/process-scheduled (cron de campanhas agendadas)
#  - /api/broadcasts/send (bypass interno quando process-scheduled chama)
CRON_SECRET=

# ─── OPENAI ───────────────────────────────────────────────────────────────────
# Usado pelo agente IA. Mesma chave também vai em agent/.env.local.
# Console: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo default usado pelo agente quando nenhum override está configurado.
# Sugestões: gpt-4o-mini (custo baixo), gpt-4o (qualidade alta)
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# ─── BROADCASTS ──────────────────────────────────────────────────────────────
# Secret HMAC para tokens de descadastro em emails de campanha.
# Usado por: /api/unsubscribe (verifica) + /api/broadcasts/send (gera).
# >= 32 chars. Sem isso, footer de descadastro não é injetado em emails
# (degradação graciosa — campanhas continuam, só sem link de opt-out).
# Gere com: openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# ─── NOTIFICATION SERVER (envio de email via servidor externo) ──────────────
# URL e API key são GLOBAIS — compartilhadas entre todos os businesses.
# Cada business configura apenas seu SMTP (host/user/pass/from) via UI.
# A API key DEVE ser idêntica ao INTERNAL_API_KEY do .env do notification-server.
# Mesmo segredo é usado também como HMAC para validar webhooks de bounce.
NOTIFICATION_SERVER_URL=
NOTIFICATION_SERVER_API_KEY=

# ─── DOCKER + CLOUDFLARE TUNNEL (apenas em produção self-hosted) ────────────
# Porta host do Next.js container (interna continua 3000)
APP_PORT=3000
# Token do Cloudflare Tunnel — necessário SOMENTE quando rodando com:
#   docker compose --profile tunnel up -d
# Painel: Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
