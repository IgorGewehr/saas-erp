# ─── APP SETTINGS ─────────────────────────────────────────────────────────────
# URL base do sistema (Ngrok em dev, dominio real em producao)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── FIREBASE CONFIG ──────────────────────────────────────────────────────────
# Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (JSON em uma unica linha)
# Gere em: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT=

# ─── META / FACEBOOK CONFIG ──────────────────────────────────────────────────
# Painel: https://developers.facebook.com/apps/
META_APP_ID=
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=

# Webhook Verify Tokens (definidos no painel Meta > Webhooks)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_FACEBOOK_VERIFY_TOKEN=

# ─── SEFAZ / FISCAL ──────────────────────────────────────────────────────────
SEFAZ_API_URL=http://localhost:3333
SEFAZ_API_KEY=

# ─── SECURITY / ENCRYPTION ───────────────────────────────────────────────────
# Chave AES-256-GCM para criptografar tokens no Firestore (exatos 32 caracteres)
ENCRYPTION_KEY=
