# syntax=docker/dockerfile:1.7
# Development image — hot reload via uvicorn --reload + volume mount.
# Use:  docker compose -f docker-compose.yml -f docker-compose.dev.yml up

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    HOST=0.0.0.0 \
    PORT=8080 \
    APP_ENV=development

WORKDIR /app

# Install deps (incl. dev) — watchfiles é necessário pro --reload
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen && uv pip install watchfiles

# Código é montado via volume no compose.dev; aqui só baseline
COPY main.py ./
COPY app ./app

EXPOSE 8080

# --reload reage a qualquer mudança em main.py / app/**
CMD ["sh", "-c", "uvicorn main:app --host ${HOST} --port ${PORT} --reload"]
