# ServicePro Agent — environment

# Required: shared secret used to HMAC-sign all traffic between Next.js and this service.
# Must match NEXT.JS's AGENT_SHARED_SECRET env var exactly.
AGENT_SHARED_SECRET=change-me-to-a-long-random-string

# Required: OpenAI credentials
OPENAI_API_KEY=sk-...

# Required: base URL where the Next.js backend lives (the agent calls its REST tools here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional: specific model override (defaults to what each business configures in Settings)
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# Optional: LangSmith tracing (set to enable)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=servicepro-agent

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Safety
AGENT_MAX_ITERATIONS=8
AGENT_REQUEST_TIMEOUT_S=30

# Observability (Wave 6)
REDACT_PII_IN_TRACES=true
# LANGSMITH_EVALS_ENABLED=false
# LANGSMITH_GROUNDEDNESS_SAMPLE=0.05

# Docker / Cloudflare Tunnel
# APP_ENV controla project name do LangSmith (development → servicepro-dev, production → servicepro-prod)
APP_ENV=development
# Quantidade de workers uvicorn (I/O-bound — sobe com tráfego simultâneo)
WORKERS=2
# Cloudflare Tunnel (named, persistente) — cole o token do dashboard
# CLOUDFLARE_TUNNEL_TOKEN=eyJhbGciOi...
