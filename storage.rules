rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUnderSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType is string
          && request.resource.contentType.lower().matches('image/.*');
    }

    function isCertificate() {
      return request.resource.contentType.matches('application/x-pkcs12')
          || request.resource.contentType.matches('application/octet-stream')
          || request.resource.contentType.matches('application/.*');
    }

    function isMedia() {
      return request.resource.contentType is string
          && (request.resource.contentType.lower().matches('image/.*')
           || request.resource.contentType.lower().matches('video/.*')
           || request.resource.contentType.lower().matches('audio/.*')
           || request.resource.contentType == 'application/pdf');
    }

    // ── User avatars ─────────────────────────────────────────────────────────
    // Path: users/{uid}/avatar
    match /users/{userId}/{fileName} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && isImage()
                   && isUnderSize(5);
    }

    // ── Fiscal certificates (PFX) ─────────────────────────────────────────────
    // Path: businesses/{businessId}/certificates/{fileName}
    // More specific than the general businesses path below — matched first.
    match /businesses/{businessId}/certificates/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated()
                    && isCertificate()
                    && isUnderSize(10);
      allow delete: if isAuthenticated();
    }

    // ── General business files (logo, menu images, etc.) ─────────────────────
    // Path: businesses/{businessId}/...
    match /businesses/{businessId}/{path=**} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isUnderSize(10);
      allow delete: if isAuthenticated();
    }

    // ── Product images ────────────────────────────────────────────────────────
    // Path: products/{businessId}/{productId}/{fileName}
    match /products/{businessId}/{productId}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isImage() && isUnderSize(5);
      allow delete: if isAuthenticated();
    }

    // ── Conversation media (WhatsApp/FB/IG attachments) ───────────────────────
    // Path: conversations/{businessId}/{conversationId}/{fileName}
    match /conversations/{businessId}/{conversationId}/{fileName} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated() && isMedia() && isUnderSize(25);
    }

    // ── Contact avatars (server-only via Admin SDK) ───────────────────────────
    // Path: contactAvatars/{businessId}/...
    match /contactAvatars/{businessId}/{rest=**} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
