rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUnderSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType is string
          && request.resource.contentType.matches('image/.*');
    }

    function isMedia() {
      return request.resource.contentType is string
          && (request.resource.contentType.matches('image/.*')
           || request.resource.contentType.matches('video/.*')
           || request.resource.contentType.matches('audio/.*')
           || request.resource.contentType == 'application/pdf');
    }

    // Allowlist mais ampla para anexos genéricos (Kanban): imagens, vídeos,
    // áudio, PDF, documentos de escritório, texto/código, dados estruturados
    // (XML/JSON/CSV — comum em NF-e brasileiras) e arquivos comprimidos.
    // Bloqueia executáveis e formatos potencialmente perigosos.
    function isAttachment() {
      return request.resource.contentType is string
          && (request.resource.contentType.matches('image/.*')
           || request.resource.contentType.matches('video/.*')
           || request.resource.contentType.matches('audio/.*')
           || request.resource.contentType.matches('text/.*')
           || request.resource.contentType == 'application/pdf'
           || request.resource.contentType == 'application/xml'
           || request.resource.contentType == 'application/json'
           || request.resource.contentType == 'application/zip'
           || request.resource.contentType == 'application/x-zip-compressed'
           || request.resource.contentType == 'application/x-rar-compressed'
           || request.resource.contentType == 'application/vnd.rar'
           || request.resource.contentType == 'application/x-7z-compressed'
           || request.resource.contentType == 'application/msword'
           || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
           || request.resource.contentType == 'application/vnd.ms-excel'
           || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
           || request.resource.contentType == 'application/vnd.ms-powerpoint'
           || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
           || request.resource.contentType == 'application/vnd.oasis.opendocument.text'
           || request.resource.contentType == 'application/vnd.oasis.opendocument.spreadsheet'
           || request.resource.contentType == 'application/vnd.oasis.opendocument.presentation'
           || request.resource.contentType == 'application/rtf');
    }

    // ── User avatars ─────────────────────────────────────────────────────────
    // Path: users/{uid}/avatar
    match /users/{userId}/{fileName} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && isImage()
                   && isUnderSize(5);
    }

    // ── All business-level files (logo, menu images, certificates, etc.) ─────
    // Path: businesses/{businessId}/...
    // NOTE: belongsToBusiness() intentionally absent — firestore.get() in Storage
    // rules causes circular reads via the users/{uid} allow read rule, producing
    // silent storage/unauthorized denials. Tenant isolation is enforced at the
    // app layer (businessId comes from useAuth()).
    match /businesses/{businessId}/{path=**} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isUnderSize(10);
      allow delete: if isAuthenticated();
    }

    // ── Product images ────────────────────────────────────────────────────────
    // Path: products/{businessId}/{productId}/{fileName}
    match /products/{businessId}/{productId}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isImage() && isUnderSize(5);
      allow delete: if isAuthenticated();
    }

    // ── Kanban card attachments ───────────────────────────────────────────────
    // Path: kanban/{businessId}/{cardId}/{fileName}
    // Aceita anexos genéricos (docs, planilhas, XMLs de NF-e, etc.) — não só mídia
    match /kanban/{businessId}/{cardId}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isAttachment() && isUnderSize(25);
      allow delete: if isAuthenticated();
    }

    // ── Conversation media (WhatsApp/FB/IG attachments) ───────────────────────
    // Cap 100MB alinhado com limite de documento da WhatsApp Cloud API.
    // Imagem/vídeo/áudio inline têm cap mais restrito client-side (5/16/16 MB);
    // esta rule é o ceiling absoluto pra cobrir documentos (PDFs grandes,
    // planilhas) + fallback "enviar vídeo > 16MB como documento" do Composer.
    // Path: conversations/{businessId}/{conversationId}/{fileName}
    match /conversations/{businessId}/{conversationId}/{fileName} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated() && isMedia() && isUnderSize(100);
    }

    // ── Snippet media (mídia anexa a respostas rápidas) ───────────────────────
    // Path: snippets/{businessId}/{fileName}
    // Mesmas restrições de conversations (Meta limita tamanhos similares no
    // envio). isAttachment vs isMedia: optamos por isMedia pra forçar tipos
    // que a Meta aceita — operador não cria snippet com .zip pra enviar.
    match /snippets/{businessId}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isMedia() && isUnderSize(25);
      allow delete: if isAuthenticated();
    }

    // ── Contact avatars (server-only via Admin SDK) ───────────────────────────
    // Path: contactAvatars/{businessId}/...
    match /contactAvatars/{businessId}/{rest=**} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
