rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the user's businessId from their Firestore profile
    function userBusinessId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId;
    }

    // Check if the user belongs to the specified business
    function belongsToBusiness(businessId) {
      return isAuthenticated() && userBusinessId() == businessId;
    }

    // Validate file size (in bytes)
    function isUnderSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // Validate image content type
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
    }

    // Validate certificate file
    function isCertificate() {
      return request.resource.contentType.matches('application/x-pkcs12')
             || request.resource.contentType.matches('application/octet-stream');
    }

    // Validate media attachment type (images, videos, audio, common docs)
    function isMedia() {
      return request.resource.contentType.matches('image/.*')
             || request.resource.contentType.matches('video/.*')
             || request.resource.contentType.matches('audio/.*')
             || request.resource.contentType.matches('application/pdf');
    }

    // User's role from Firestore profile
    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (userRole() == 'founder' || userRole() == 'admin');
    }

    // ============================================
    // USER AVATARS
    // Path: users/{uid}/avatar
    // ============================================
    match /users/{userId}/{fileName} {
      // Anyone authenticated can view user avatars (for team presence panels)
      allow read: if isAuthenticated();

      // Users can only upload their own avatar
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && isImage()
                   && isUnderSize(5); // Max 5MB
    }

    // ============================================
    // PRODUCT IMAGES
    // Path: products/{businessId}/{productId}/{fileName}
    // ============================================
    match /products/{businessId}/{productId}/{fileName} {
      // Only users in the same business can read product images
      allow read: if isAuthenticated()
                  && belongsToBusiness(businessId);

      // Only users in the same business can upload product images
      allow write: if isAuthenticated()
                   && belongsToBusiness(businessId)
                   && isImage()
                   && isUnderSize(5); // Max 5MB

      allow delete: if isAuthenticated()
                    && belongsToBusiness(businessId);
    }

    // ============================================
    // BUSINESS LOGOS
    // Path: businesses/{businessId}/logo
    // ============================================
    match /businesses/{businessId}/{fileName} {
      // Anyone authenticated can read business logos (public branding)
      allow read: if isAuthenticated();

      // Only admins of the business can upload/replace the logo
      allow write: if isAuthenticated()
                   && belongsToBusiness(businessId)
                   && isAdmin()
                   && isImage()
                   && isUnderSize(5); // Max 5MB
    }

    // ============================================
    // FISCAL CERTIFICATES (PFX)
    // Path: businesses/{businessId}/certificates/{fileName}
    // ============================================
    match /businesses/{businessId}/certificates/{fileName} {
      // Certificados são sensíveis — apenas admins podem ler/escrever
      allow read: if isAuthenticated()
                  && belongsToBusiness(businessId)
                  && isAdmin();

      allow write: if isAuthenticated()
                   && belongsToBusiness(businessId)
                   && isAdmin()
                   && (isCertificate() || request.resource.contentType.matches('application/.*'))
                   && isUnderSize(10); // Max 10MB for PFX files

      allow delete: if isAuthenticated()
                    && belongsToBusiness(businessId)
                    && isAdmin();
    }

    // ============================================
    // CONVERSATION MEDIA (WhatsApp/FB/IG attachments)
    // Path: conversations/{businessId}/{conversationId}/{fileName}
    // ============================================
    match /conversations/{businessId}/{conversationId}/{fileName} {
      allow read: if isAuthenticated() && belongsToBusiness(businessId);

      // Outbound uploads (equipe enviando arquivo ao contato)
      allow write: if isAuthenticated()
                   && belongsToBusiness(businessId)
                   && isMedia()
                   && isUnderSize(25); // WhatsApp limit ~16MB; dar margem
    }

    // ============================================
    // CONTACT AVATARS CACHED FROM META (downloads do webhook)
    // Path: contactAvatars/{businessId}/{externalId}/{fileName}
    // ============================================
    match /contactAvatars/{businessId}/{rest=**} {
      // Leitura pelo time inteiro (aparecem em conversas/CRM)
      allow read: if isAuthenticated() && belongsToBusiness(businessId);
      // Escritas são feitas pelo servidor via admin SDK (bypassa). Aqui negamos
      // writes do cliente explicitamente.
      allow write: if false;
    }

    // ============================================
    // CATCH-ALL: Deny everything else
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
