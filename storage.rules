rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUnderSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType is string
          && request.resource.contentType.lower().matches('image/.*');
    }

    function isMedia() {
      return request.resource.contentType is string
          && (request.resource.contentType.lower().matches('image/.*')
           || request.resource.contentType.lower().matches('video/.*')
           || request.resource.contentType.lower().matches('audio/.*')
           || request.resource.contentType == 'application/pdf');
    }

    // ── User avatars ────────────────────────────────────────────────────────
    // Path: users/{uid}/avatar
    // uid check is sufficient — no Firestore read needed.
    match /users/{userId}/{fileName} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && isImage()
                   && isUnderSize(5);
    }

    // ── All business-level files ─────────────────────────────────────────────
    // Covers: logo, certificates, menuCategories, and any future paths.
    // Tenant isolation is enforced at the app layer (businessId comes from
    // useAuth() and the UI restricts which roles can write).
    // Firestore reads are intentionally absent — firestore.get() in Storage
    // rules is subject to Firestore rules which can produce circular reads
    // through the users/{uid} allow read rule, causing silent denials.
    match /businesses/{businessId}/{path=**} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated() && isUnderSize(10);
      allow delete: if isAuthenticated();
    }

    // ── Product images ───────────────────────────────────────────────────────
    // Path: products/{businessId}/{productId}/{fileName}
    match /products/{businessId}/{productId}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isImage() && isUnderSize(5);
      allow delete: if isAuthenticated();
    }

    // ── Conversation media (WhatsApp/FB/IG attachments) ──────────────────────
    // Path: conversations/{businessId}/{conversationId}/{fileName}
    match /conversations/{businessId}/{conversationId}/{fileName} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated() && isMedia() && isUnderSize(25);
    }

    // ── Contact avatars (server-only via Admin SDK) ──────────────────────────
    // Path: contactAvatars/{businessId}/...
    match /contactAvatars/{businessId}/{rest=**} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── Catch-all: deny everything else ─────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
